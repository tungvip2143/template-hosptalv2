{
  "name": "remote-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "reinstall": "rm -rf node_modules package-lock.json && npm i --legacy-peer-deps",
    "go": "pnkx-scripts check-update-pnkx && npm run generate-feature-flag-keys && pnkx-scripts generate-env && vite --mode development",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run generate-feature-flag-keys && pnkx-scripts generate-env .env.production && vite build --mode production",
    "lint": "eslint .",
    "preview": "vite preview",
    "dev:remote": "pnkx-scripts bootstrap-manifest remote && npm run go",
    "dev:local": "pnkx-scripts bootstrap-manifest local && npm run go",
    "dev:hybrid": "pnkx-scripts bootstrap-manifest hybrid && npm run go",
    "sync-locales": "pnkx-scripts sync-locales",
    "gen-module": "pnkx-scripts gen-module",
    "build:ci": "npx --yes @pnkx-lib/scripts perform-build ${PROJECT_KEY}",
    "switch-env": "pnkx-scripts switch-env",
    "generate-feature-flag-keys": "pnkx-scripts generate-feature-flag-keys --source-dir src/features/flags --output src/features/keys.generated.ts",
    "generate-feature-flag-manifest": "pnkx-scripts generate-feature-flag-manifest --source-dir src/features/flags --output src/features/manifest.sync.json",
    "sync-feature-flags": "npm run generate-feature-flag-keys && npm run generate-feature-flag-manifest && pnkx-scripts sync-feature-flags --manifest src/features/manifest.sync.json"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^1.24.0",
    "@module-federation/runtime": "^2.1.0",
    "@module-federation/vite": "1.11.1",
    "@pnkx-lib/core": "0.1.0-staging.317",
    "@pnkx-lib/icon": "0.1.0-staging.126",
    "@pnkx-lib/ui": "0.1.0-staging.260",
    "@tailwindcss/vite": "^4.0.17",
    "@tanstack/react-query": "^5.75.4",
    "@tanstack/react-query-devtools": "^5.76.1",
    "i18next": "^25.4.2",
    "js-cookie": "^3.0.5",
    "lodash": "^4.17.21",
    "query-string": "^9.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.57.0",
    "react-i18next": "^15.7.3",
    "react-router": "^7.6.0",
    "tailwindcss": "^4.0.17",
    "vite-plugin-compression": "^0.5.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@pnkx-lib/scripts": "0.1.0-staging.26",
    "@types/js-cookie": "^3.0.6",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.15.3",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.2.7",
    "@vitejs/plugin-react-swc": "^3.8.0",
    "chokidar": "^4.0.3",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "terser": "^5.43.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.26.1",
    "vite": "^6.2.6"
  }
}
